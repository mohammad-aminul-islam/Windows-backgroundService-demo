{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "BackupSettings": {
    "CronExpression": "0 2 * * *"
  },
  "ConnectionStrings": {
    "Hangfire": "Host=YOUR_SERVER_ADDRESS;Port=5432;Database=hangfire;Username=YOUR_USERNAME;Password=YOUR_PASSWORD"
  },
  "SqlServer": {
    "Server": "YOUR_SERVER_ADDRESS",
    "DatabaseNames": [ "DB1", "DB2" ],
    "UserName": "YOUR_USERNAME",
    "Password": "YOUR_PASSWORD",
    "BackupDirectory": "C:\\Backups\\SqlServer"
  },
  "Postgres": {
    "Server": "YOUR_SERVER_ADDRESS",
    "DatabaseNames": [ "DB1" ],
    "UserName": "YOUR_USERNAME",
    "Password": "YOUR_PASSWORD",
    "BackupDirectory": "C:\\Backups\\Postgres",
    "PgDumpPath": "pg_dump",
    "ContainerName": ""
  },
  "Telegram": {
    "Token": "YOUR_BOT_TOKEN",
    "ChannelId": -100123456789
  }
}
